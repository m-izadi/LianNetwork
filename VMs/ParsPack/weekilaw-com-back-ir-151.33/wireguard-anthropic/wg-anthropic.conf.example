# WireGuard client on weekilaw-com-back-ir (178.239.151.33)
# Goal: ONLY api.anthropic.com (160.79.104.0/23) via pfSense; everything else unchanged.
#
# Install:
#   sudo cp wg-anthropic.conf.example /etc/wireguard/wg-anthropic.conf
#   sudo chmod 600 /etc/wireguard/wg-anthropic.conf
#   # fill PrivateKey / Address / Peer PublicKey / Endpoint
#   sudo systemctl enable --now wg-quick@wg-anthropic

[Interface]
PrivateKey = CLIENT_PRIVATE_KEY_HERE
Address = 10.66.66.2/32
# Do NOT set DNS= here (would hijack resolver for the whole host).
# Table=auto (default): wg-quick only installs routes for AllowedIPs below.

[Peer]
PublicKey = PFSENSE_WIREGUARD_PUBLIC_KEY_HERE
# Optional: PresharedKey = ...
Endpoint = PFSENSE_PUBLIC_IP_OR_HOSTNAME:51820
# Anthropic inbound API range (api.anthropic.com → 160.79.104.0/23)
# https://platform.claude.com/docs/en/api/ip-addresses
AllowedIPs = 160.79.104.0/23
PersistentKeepalive = 25
