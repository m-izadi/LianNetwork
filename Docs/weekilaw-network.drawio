        </mxCell>
        <mxCell id="p2_mik" value="&lt;b&gt;MikroTik Interfaces (from backup + screenshot)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;
&lt;table cellpadding=&quot;2&quot; style=&quot;font-size:10px;width:100%&quot;&gt;
&lt;tr style=&quot;background:#eee&quot;&gt;&lt;td&gt;&lt;b&gt;Interface&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Type&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Status / Role&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;ether1-radio&lt;/td&gt;&lt;td&gt;Ethernet&lt;/td&gt;&lt;td&gt;Running — WAN radio (high traffic)&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;ether2-fiber&lt;/td&gt;&lt;td&gt;Ethernet&lt;/td&gt;&lt;td&gt;Running — WAN fiber&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;ether3-starlink&lt;/td&gt;&lt;td&gt;Ethernet&lt;/td&gt;&lt;td&gt;Down — WAN Starlink&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;ether6-tplink_sw&lt;/td&gt;&lt;td&gt;Ethernet&lt;/td&gt;&lt;td&gt;Running — TP-Link switch&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;ether9-hp&lt;/td&gt;&lt;td&gt;Ethernet&lt;/td&gt;&lt;td&gt;Running — HP server / VMs&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;ether10-supermicro&lt;/td&gt;&lt;td&gt;Ethernet&lt;/td&gt;&lt;td&gt;Running — SuperMicro&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;BR-TRUNK + vlan10-17&lt;/td&gt;&lt;td&gt;Bridge/VLAN&lt;/td&gt;&lt;td&gt;Trunk: radio, vpn, fiber, starlink, servers, IPMI&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;br-radio/fiber/starlink&lt;/td&gt;&lt;td&gt;Bridge&lt;/td&gt;&lt;td&gt;Per-WAN policy routing&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;br-servers, br-vpn, br-ovpn&lt;/td&gt;&lt;td&gt;Bridge&lt;/td&gt;&lt;td&gt;Servers + VPN traffic&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;ovpn-server&lt;/td&gt;&lt;td&gt;OpenVPN&lt;/td&gt;&lt;td&gt;ParsPack ↔ LAN access&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;hs&lt;/td&gt;&lt;td&gt;SSTP client&lt;/td&gt;&lt;td&gt;Active → France&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;tun2-L2&lt;/td&gt;&lt;td&gt;L2TP client&lt;/td&gt;&lt;td&gt;Active → France&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;eoip-hassani*&lt;/td&gt;&lt;td&gt;EoIP&lt;/td&gt;&lt;td&gt;Disabled&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#dae8fc;fontSize=10;" vertex="1" parent="1">
